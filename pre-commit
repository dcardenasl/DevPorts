#!/usr/bin/env bash
#
# Style only: check Rust formatting and keep frontend checks scoped to staged files.
#
# `dev` is where work lands quickly. The real gate is the pull request into
# `main`, where CI runs clippy with -D warnings, the complete test suite and the
# bindings drift check. Running any of that here would cost minutes on every
# commit and buy nothing. Style stays because it is fast and keeps diffs free of
# formatting noise.
#
# Each check activates only once its toolchain exists in the repository, so the
# hook is valid from the first documentation-only commit.
#
set -Eeuo pipefail

# Hooks do not run through an interactive shell, so the toolchains have to be
# put on PATH explicitly rather than relying on a profile being sourced.
[[ -f "${HOME}/.cargo/env" ]] && source "${HOME}/.cargo/env"
export PATH="/opt/homebrew/bin:${PATH}"

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

fail() {
    echo ""
    echo "  ✖ pre-commit: $1"
    echo "    fix: $2"
    echo ""
    exit 1
}

if [[ -f Cargo.toml ]]; then
    if ! cargo fmt --all --check; then
        fail "Rust formatting failed" "run cargo fmt --all, then stage only the intended Rust files"
    fi
fi

if git diff --cached --quiet; then
    exit 0
fi

# Frontend checks run from ui/ and only when its tooling is installed.
if [[ ! -f ui/package.json || ! -d ui/node_modules ]]; then
    exit 0
fi

ESLINT_FILES=()
PRETTIER_FILES=()
while IFS= read -r -d '' path; do
    case "${path}" in
        ui/src/bindings.ts)
            # Generated by tauri-specta and intentionally ignored by ESLint.
            ;;
        ui/*.js|ui/*.jsx|ui/*.mjs|ui/*.cjs|ui/*.ts|ui/*.tsx|ui/*/*.js|ui/*/*.jsx|ui/*/*.mjs|ui/*/*.cjs|ui/*/*.ts|ui/*/*.tsx)
            ESLINT_FILES+=("${path#ui/}")
            PRETTIER_FILES+=("${path#ui/}")
            ;;
        ui/*.json|ui/*.css|ui/*.html|ui/*.yaml|ui/*.yml|ui/*/*.json|ui/*/*.css|ui/*/*.html)
            PRETTIER_FILES+=("${path#ui/}")
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#ESLINT_FILES[@]} > 0)); then
    if ! (cd ui && npm exec -- eslint --max-warnings=0 -- "${ESLINT_FILES[@]}"); then
        fail "ESLint failed for staged source files" "fix the reported diagnostics and rerun ./pre-commit"
    fi
fi

if ((${#PRETTIER_FILES[@]} > 0)); then
    if ! (cd ui && npm exec -- prettier --check -- "${PRETTIER_FILES[@]}"); then
        fail "Prettier failed for staged files" "format the reported files and rerun ./pre-commit"
    fi
fi
